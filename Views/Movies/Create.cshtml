@model TopMovies.Models.Movie
@{
    ViewData["Title"] = "Додати фільм";
}

<div class="form-page">
    <h1>Додати фільм</h1>

    <form asp-action="Create" enctype="multipart/form-data" class="movie-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-input" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Director"></label>
            <input asp-for="Director" class="form-input" />
            <span asp-validation-for="Director" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Genre"></label>
            <input asp-for="Genre" class="form-input" />
            <span asp-validation-for="Genre" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ReleaseYear"></label>
            <input asp-for="ReleaseYear" class="form-input" />
            <span asp-validation-for="ReleaseYear" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="PosterFile">Файл постера</label>
            <input asp-for="PosterFile" class="form-input" type="file" accept="image/*" />
        </div>

        <div class="form-group">
            <label asp-for="PosterPath">Або шлях/URL до зображення</label>
            <input asp-for="PosterPath" class="form-input" placeholder="/images/posters/mymovie.svg" />
            <span asp-validation-for="PosterPath" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-input" rows="4"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Зберегти</button>
            <a asp-action="Index" class="btn-ghost">Скасувати</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/custom-validation.js"></script>
}
